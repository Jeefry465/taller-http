{
  "info": {
    "name": "Taller HTTP CORS - Equipo 3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. GET envios - valido (200)",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('La respuesta es una lista de envios', () => pm.expect(pm.response.json()).to.be.an('array'));"
      ]}}],
      "request": {
        "method": "GET",
        "header": [{"key": "X-Red-Equipo", "value": "CIAF-3"}],
        "url": {"raw": "http://127.0.0.1:3000/api/envios", "protocol": "http", "host": ["127.0.0.1"], "port": "3000", "path": ["api", "envios"]}
      }
    },
    {
      "name": "2. POST envios - valido (201)",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('Status 201', () => pm.response.to.have.status(201));",
        "pm.test('El envio creado contiene los campos esperados', () => {",
        "  const envio = pm.response.json();",
        "  pm.expect(envio).to.have.property('id');",
        "  pm.expect(envio.guia).to.be.a('string');",
        "  pm.expect(envio.destino).to.eql('Manizales');",
        "  pm.expect(envio.estado).to.eql('En bodega');",
        "});"
      ]}}],
      "request": {
        "method": "POST",
        "header": [
          {"key": "X-Red-Equipo", "value": "CIAF-3"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {"mode": "raw", "raw": "{\n  \"guia\": \"ENV-{{$guid}}\",\n  \"destino\": \"Manizales\",\n  \"estado\": \"En bodega\"\n}"},
        "url": {"raw": "http://127.0.0.1:3000/api/envios", "protocol": "http", "host": ["127.0.0.1"], "port": "3000", "path": ["api", "envios"]}
      }
    },
    {
      "name": "3. GET envios - sin header (401)",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('Status 401', () => pm.response.to.have.status(401));"
      ]}}],
      "request": {
        "method": "GET",
        "header": [],
        "url": {"raw": "http://127.0.0.1:3000/api/envios", "protocol": "http", "host": ["127.0.0.1"], "port": "3000", "path": ["api", "envios"]}
      }
    },
    {
      "name": "4. Verificar headers de respuesta (CORS y X-Servidor-Procesado)",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('X-Servidor-Procesado = Equipo-3', () => pm.response.to.have.header('X-Servidor-Procesado', 'Equipo-3'));",
        "pm.test('Access-Control-Allow-Origin = http://localhost:5500', () => pm.response.to.have.header('Access-Control-Allow-Origin', 'http://localhost:5500'));"
      ]}}],
      "request": {
        "method": "GET",
        "header": [
          {"key": "X-Red-Equipo", "value": "CIAF-3"},
          {"key": "Origin", "value": "http://localhost:5500"}
        ],
        "url": {"raw": "http://127.0.0.1:3000/api/envios", "protocol": "http", "host": ["127.0.0.1"], "port": "3000", "path": ["api", "envios"]}
      }
    },
    {
      "name": "5. POST envios - datos incompletos (400)",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('Status 400', () => pm.response.to.have.status(400));",
        "pm.test('Indica que los datos son incompletos', () => pm.expect(pm.response.json().error).to.eql('Datos incompletos'));"
      ]}}],
      "request": {
        "method": "POST",
        "header": [
          {"key": "X-Red-Equipo", "value": "CIAF-3"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {"mode": "raw", "raw": "{\n  \"guia\": \"ENV-INCOMPLETO\",\n  \"destino\": \"Manizales\"\n}"},
        "url": {"raw": "http://127.0.0.1:3000/api/envios", "protocol": "http", "host": ["127.0.0.1"], "port": "3000", "path": ["api", "envios"]}
      }
    },
    {
      "name": "6. Preflight CORS - POST desde el origen permitido (204)",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('Status 204', () => pm.response.to.have.status(204));",
        "pm.test('Permite el origen del frontend', () => pm.response.to.have.header('Access-Control-Allow-Origin', 'http://localhost:5500'));",
        "pm.test('Permite el metodo POST', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Methods')).to.include('POST'));",
        "pm.test('Permite los headers requeridos', () => {",
        "  const headersPermitidos = pm.response.headers.get('Access-Control-Allow-Headers').toLowerCase();",
        "  pm.expect(headersPermitidos).to.include('content-type');",
        "  pm.expect(headersPermitidos).to.include('x-red-equipo');",
        "});"
      ]}}],
      "request": {
        "method": "OPTIONS",
        "header": [
          {"key": "Origin", "value": "http://localhost:5500"},
          {"key": "Access-Control-Request-Method", "value": "POST"},
          {"key": "Access-Control-Request-Headers", "value": "content-type,x-red-equipo"}
        ],
        "url": {"raw": "http://127.0.0.1:3000/api/envios", "protocol": "http", "host": ["127.0.0.1"], "port": "3000", "path": ["api", "envios"]}
      }
    }
  ]
}
